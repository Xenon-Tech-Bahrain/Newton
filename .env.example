# Newton Local Edition - copy to .env and fill in your values.
# Only ONE provider is needed; the first one detected is used.

# --- Database (required) -----------------------------------------------------
# Newton stores everything in PostgreSQL. Use a free hosted database or a local
# server. The server URL must include a database name.
DATABASE_URL="postgresql://user:password@host:5432/xenon?sslmode=require"
# Local PostgreSQL usually needs no TLS: append ?sslmode=disable
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/xenon?sslmode=disable"
# Set to "no-verify" only for a host with a self-signed certificate.
# DATABASE_SSL="require"

# --- AI provider (pick one) --------------------------------------------------
# Google Gemini (recommended - fast, free tier, supports images)
# Get a key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# OpenAI
# OPENAI_API_KEY=""

# Anthropic Claude
# ANTHROPIC_API_KEY=""

# Groq (fast, free tier)
# GROQ_API_KEY=""

# OpenRouter (access to 100+ models with one key)
# OPENROUTER_API_KEY=""

# Ollama (local, no API key needed - just run `ollama serve`)
# OLLAMA_HOST="http://localhost:11434"

# Custom OpenAI-compatible endpoint (LM Studio, LocalAI, vLLM)
# CUSTOM_API_KEY="not-needed"
# CUSTOM_ENDPOINT="http://localhost:1234/v1/chat/completions"

# Optional: override the default model for your provider
# NEWTON_MODEL="gemini-3.5-flash-lite"

# --- Local edition behaviour -------------------------------------------------
# Migrations run automatically on start; set to 1 to skip them.
# NEWTON_SKIP_MIGRATE="1"
# Session signing secret. Generated values are fine for a single machine.
# AUTH_SECRET=""
